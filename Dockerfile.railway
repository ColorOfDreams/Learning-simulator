# Build context: repo root — cho phép COPY src/database/data vào image
# Railway config: Root Directory = /, Dockerfile Path = Dockerfile.railway

FROM node:22-alpine
WORKDIR /app
RUN corepack enable

# Copy backend source (bao gồm package.json, yarn.lock, .yarnrc.yml, src/, tsconfig, nest-cli.json)
COPY src/backend/ .

# Install all deps (bao gồm devDeps để build NestJS)
RUN yarn install --immutable

# Build TypeScript → dist/
RUN yarn build

# Bundle learning data (1.3MB) vào image
COPY src/database/data ./data

EXPOSE 3000
CMD ["node", "dist/main"]
