# Build context: repo root
# Railway config: Root Directory = /, Dockerfile Path = Dockerfile.frontend.railway

FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable

# Copy frontend source (baseUrl = /app/)
COPY src/frontend/ ./

# Copy simulations vào /simulations/ để khớp path alias "../simulations/*"
COPY src/simulations/ /simulations/

# Install deps
RUN yarn install --immutable

# Build React + Umi.js
RUN yarn build

FROM nginx:alpine
COPY --from=build /app/.nginx/nginx.conf /etc/nginx/conf.d/default.conf
WORKDIR /var/www/website
RUN rm -rf ./*
COPY --from=build /app/dist .
ENTRYPOINT ["nginx", "-g", "daemon off;"]
