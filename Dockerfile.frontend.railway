# Build context: repo root
# Railway config: Root Directory = /, Dockerfile Path = Dockerfile.frontend.railway

FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable

# Khai báo ARG trước COPY/install để Docker cache bị invalidate khi bất kỳ env var nào thay đổi
ARG APP_CONFIG_IP_ROOT
ARG APP_CONFIG_GOOGLE_CLIENT_ID=479455851124-pg3d9fbatkdpo9d1klf6uehecdi73eua.apps.googleusercontent.com
ARG APP_CONFIG_TEN_TRUONG
ARG APP_CONFIG_TIEN_TO_TRUONG
ARG APP_CONFIG_TEN_TRUONG_VIET_TAT_TIENG_ANH
ARG APP_CONFIG_GA_ID
ARG APP_CONFIG_SENTRY_DSN
ARG APP_CONFIG_ONE_SIGNAL_ID
ARG APP_CONFIG_PRIMARY_COLOR
ARG APP_CONFIG_HIGHLIGHT_COLOR
ARG APP_CONFIG_PHAN_QUYEN_URL
ARG GOOGLE_CLIENT_ID
ENV APP_CONFIG_IP_ROOT=$APP_CONFIG_IP_ROOT \
    APP_CONFIG_GOOGLE_CLIENT_ID=$APP_CONFIG_GOOGLE_CLIENT_ID \
    APP_CONFIG_TEN_TRUONG=$APP_CONFIG_TEN_TRUONG \
    APP_CONFIG_TIEN_TO_TRUONG=$APP_CONFIG_TIEN_TO_TRUONG \
    APP_CONFIG_TEN_TRUONG_VIET_TAT_TIENG_ANH=$APP_CONFIG_TEN_TRUONG_VIET_TAT_TIENG_ANH \
    APP_CONFIG_GA_ID=$APP_CONFIG_GA_ID \
    APP_CONFIG_SENTRY_DSN=$APP_CONFIG_SENTRY_DSN \
    APP_CONFIG_ONE_SIGNAL_ID=$APP_CONFIG_ONE_SIGNAL_ID \
    APP_CONFIG_PRIMARY_COLOR=$APP_CONFIG_PRIMARY_COLOR \
    APP_CONFIG_HIGHLIGHT_COLOR=$APP_CONFIG_HIGHLIGHT_COLOR \
    APP_CONFIG_PHAN_QUYEN_URL=$APP_CONFIG_PHAN_QUYEN_URL \
    GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID

# Copy frontend source (baseUrl = /app/)
COPY src/frontend/ ./

# Copy simulations vào /simulations/ để khớp path alias "../simulations/*"
COPY src/simulations/ /simulations/

# Install deps
RUN yarn install --immutable

# CACHEBUST: thay đổi mỗi lần cần force rebuild yarn build
ARG APP_CONFIG_BUILD_TIMESTAMP
RUN echo "Build: $APP_CONFIG_BUILD_TIMESTAMP"

# Clear Umi.js build cache để đảm bảo env vars được bake vào bundle
RUN rm -rf node_modules/.cache

# Build React + Umi.js (bake env vars vào bundle)
RUN yarn build

FROM nginx:alpine
COPY --from=build /app/.nginx/nginx.conf /etc/nginx/conf.d/default.conf
WORKDIR /var/www/website
RUN rm -rf ./*
COPY --from=build /app/dist .
ENTRYPOINT ["nginx", "-g", "daemon off;"]
