# Add these settings to src/backend/.env, keeping existing auth/LLM settings.
# Use the existing Supabase project, with application data restored in scilab.
# Connect > Session pooler (IPv4), port 5432; percent-encode the password.
# Credentials belong on the backend only. Do not add sslmode URL parameters.
DATABASE_URL=postgresql://APP_ROLE.PROJECT_REF:ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres
DB_SSL=true
# Paste the provider CA as a quoted PEM with literal \n between lines.
DB_SSL_CA="-----BEGIN CERTIFICATE-----\nREPLACE_WITH_SUPABASE_CA\n-----END CERTIFICATE-----"
DB_SCHEMA=scilab
DB_POOL_MAX=5
DB_SYNCHRONIZE=false
DEMO_SEED_ON_START=false
