DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-me
DB_NAME=ai_mo_phong
# Supabase / external PostgreSQL (server-only; no sslmode query in URL)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DB_SSL=false
# DB_SSL_CA=PEM certificate from database provider when required
DB_SCHEMA=public
DB_POOL_MAX=10
# Set false after schema restore / migration. Legacy DB_* defaults stay compatible.
DB_SYNCHRONIZE=true
DEMO_SEED_ON_START=true
JWT_SECRET=replace-me
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
PORT=3000
PERMISSION_SERVICE_URL=https://phan-quyen-ai-production.up.railway.app
LEARNING_DATASET_PATH=../database/data/all-in-one.learning-data.json
LLM_API_KEY=replace-me
# Optional additional keys: JSON array; server only. Never commit real keys.
LLM_API_KEYS=[]
LLM_MAX_CONCURRENT=8
LLM_KEY_MAX_CONCURRENT=2
LLM_MAX_QUEUE=32
LLM_QUEUE_TIMEOUT_MS=3000
LLM_MAX_REQUESTS_PER_MINUTE=30
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.45
LLM_MAX_TOKENS=replace-me
EMBEDDING_API_KEY=replace-me
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
AI_DEBUG=false

# --- Giá ước tính AI (USD/1K token, tự chia từ giá niêm yết $/1M của nhà cung cấp) ---
AI_COST_PER_1K_PROMPT=
AI_COST_PER_1K_COMPLETION=
AI_COST_PER_1K_EMBEDDING=

# --- Railway Public API (admin: hiển thị metrics service backend) ---
# Tạo ở Railway → Project Settings → Tokens. Dùng header Project-Access-Token.
RAILWAY_API_TOKEN=replace-me
RAILWAY_ENVIRONMENT_ID=
RAILWAY_BACKEND_SERVICE_ID=
