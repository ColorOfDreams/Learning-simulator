# Choose one or both providers
ANTHROPIC_API_KEY=replace-me
OPENAI_API_KEY=replace-me

# Default model
DEFAULT_MODEL=claude-sonnet-4-20250514
# DEFAULT_MODEL=gpt-4o

# Logging
LOG_LEVEL=INFO

# AI Hook Logging (set by instructor)
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=replace-me
AI_LOG_DIR=.ai-log

# ── AI Study Simulator ──────────────────────────────────────────────────────
# Backend
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/ai_study_simulator
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-me
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
FRONTEND_URL=http://localhost:5173

# Frontend (Vite — prefix VITE_)
VITE_API_BASE_URL=http://localhost:3000
